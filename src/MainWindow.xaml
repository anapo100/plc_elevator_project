<Window x:Class="ElevatorHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="엘리베이터 제어"
        Width="1240" Height="780"
        MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#EFEFEF"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#D1D1D1"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>

        <SolidColorBrush x:Key="TextDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <SolidColorBrush x:Key="ShaftBg" Color="#F8F8F8"/>
        <SolidColorBrush x:Key="ShaftBorder" Color="#C0C0C0"/>

        <Style x:Key="MachinePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ControlBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoorOpenBtn" TargetType="Button" BasedOn="{StaticResource ControlBtn}">
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <Style x:Key="DoorCloseBtn" TargetType="Button" BasedOn="{StaticResource ControlBtn}">
            <Setter Property="Background" Value="#4285F4"/>
            <Setter Property="BorderBrush" Value="#2A6CD1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C97F5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A6CD1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmergencyBtn" TargetType="Button" BasedOn="{StaticResource ControlBtn}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#B71C1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueLed" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="#DFE6EF"/>
            <Setter Property="Stroke" Value="#C0C0C0"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource MachinePanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F4F4F4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="INTERNAL CONTROL" FontSize="11" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnCar5" Grid.Row="0" Grid.Column="0" Content="5" Style="{StaticResource ControlBtn}" Tag="4" Click="CarCall_Click"/>
                            <Button x:Name="btnCar4" Grid.Row="0" Grid.Column="2" Content="4" Style="{StaticResource ControlBtn}" Tag="3" Click="CarCall_Click"/>

                            <Button x:Name="btnCar3" Grid.Row="2" Grid.Column="0" Content="3" Style="{StaticResource ControlBtn}" Tag="2" Click="CarCall_Click"/>
                            <Button x:Name="btnCar2" Grid.Row="2" Grid.Column="2" Content="2" Style="{StaticResource ControlBtn}" Tag="1" Click="CarCall_Click"/>

                            <Button x:Name="btnCar1" Grid.Row="4" Grid.Column="0" Content="1" Style="{StaticResource ControlBtn}" Tag="0" Click="CarCall_Click"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,20,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnDoorOpen" Grid.Column="0" MinHeight="50" Style="{StaticResource DoorOpenBtn}" Tag="5" Click="DoorOpen_Click">
                                <StackPanel VerticalAlignment="Center" Margin="0,3">
                                    <TextBlock Text="◄ ►" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock Text="DOOR OPEN" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDoorClose" Grid.Column="2" MinHeight="50" Style="{StaticResource DoorCloseBtn}" Tag="6" Click="DoorClose_Click">
                                <StackPanel VerticalAlignment="Center" Margin="0,3">
                                    <TextBlock Text="► ◄" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock Text="DOOR CLOSE" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button x:Name="btnEmergency" Grid.Row="3" Height="60" Style="{StaticResource EmergencyBtn}" Click="Emergency_Click">
                            <StackPanel>
                                <TextBlock Text="⚠" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="EMERGENCY STOP" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="FLOOR:" FontSize="24" FontWeight="Bold" Foreground="#333333" FontFamily="Consolas" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtLcdFloor" Text="-" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock x:Name="txtLcdStatus" Text="STATUS: DOOR CLOSED" FontSize="12" Foreground="#999999" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource ShaftBg}" BorderBrush="{StaticResource ShaftBorder}" BorderThickness="2,0,2,0">
                            <Grid>
                                <UniformGrid Rows="5">
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,2"/>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,2"/>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,2"/>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,2"/>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,2"/>
                                </UniformGrid>

                                <UniformGrid Rows="5" HorizontalAlignment="Left" Margin="15,0,0,0">
                                    <TextBlock Text="5F" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" FontSize="16"/>
                                    <TextBlock Text="4F" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" FontSize="16"/>
                                    <TextBlock Text="3F" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" FontSize="16"/>
                                    <TextBlock Text="2F" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" FontSize="16"/>
                                    <TextBlock Text="1F" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" FontSize="16"/>
                                </UniformGrid>

                                <Canvas x:Name="ShaftCanvas" SizeChanged="ShaftCanvas_SizeChanged" ClipToBounds="True">
                                    <Border x:Name="MainCar" Width="66" Height="70" Background="#4A4A4A" CornerRadius="3" Padding="3" Canvas.Left="175" Canvas.Top="0">
                                        <Grid x:Name="doorHost" Background="#111111">
                                            <Border x:Name="doorLeft" Width="30" Background="#AAAAAA" BorderBrush="#888888" BorderThickness="0,0,1,0" HorizontalAlignment="Left"/>
                                            <Border x:Name="doorRight" Width="30" Background="#AAAAAA" BorderBrush="#888888" BorderThickness="1,0,0,0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Background="#F4F4F4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="EXTERNAL CALL" FontSize="11" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Border x:Name="borderExternalStatus" Grid.Row="1" Background="#C8E6C9" BorderBrush="#81C784" BorderThickness="1" Padding="8" Margin="0,0,0,20">
                            <TextBlock x:Name="txtExternalStatus" Text="SYSTEM NORMAL" FontSize="10" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="5F" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                            <Button x:Name="btnHall5Dn" Grid.Row="0" Grid.Column="2" Content="v" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="7" Click="HallCall_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="4F" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                            <Button x:Name="btnHall4Up" Grid.Row="1" Grid.Column="1" Content="^" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="5" Click="HallCall_Click"/>
                            <Button x:Name="btnHall4Dn" Grid.Row="1" Grid.Column="2" Content="v" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="6" Click="HallCall_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="3F" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                            <Button x:Name="btnHall3Up" Grid.Row="2" Grid.Column="1" Content="^" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="3" Click="HallCall_Click"/>
                            <Button x:Name="btnHall3Dn" Grid.Row="2" Grid.Column="2" Content="v" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="4" Click="HallCall_Click"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="2F" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                            <Button x:Name="btnHall2Up" Grid.Row="3" Grid.Column="1" Content="^" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="1" Click="HallCall_Click"/>
                            <Button x:Name="btnHall2Dn" Grid.Row="3" Grid.Column="2" Content="v" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="2" Click="HallCall_Click"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="1F" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                            <Button x:Name="btnHall1Up" Grid.Row="4" Grid.Column="1" Content="^" Style="{StaticResource ControlBtn}" Width="35" Height="35" Tag="0" Click="HallCall_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DashboardCard}" Padding="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="IP:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtIP" Width="130" Text="192.168.1.203" Margin="0,0,10,0" Padding="4"/>
                    <Button x:Name="btnConnect" Content="연결" Width="60" Background="#EEF3F8" BorderBrush="#CAD7E6" Click="BtnConnect_Click"/>
                    <Button x:Name="btnDisconnect" Content="해제" Width="60" Margin="5,0,0,0" Background="#EEF3F8" BorderBrush="#CAD7E6" IsEnabled="False" Click="BtnDisconnect_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="상태 요약" FontSize="18" FontWeight="Bold" Foreground="#17314F" Margin="0,0,0,15"/>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="3">
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="현재 층" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valFloor" Text="-" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="목표 층" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valTarget" Text="-" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="운행 상태" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valState" Text="IDLE" FontSize="16" FontWeight="Bold" Foreground="#17314F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="이동 방향" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valDir" Text="-" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="문 상태" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valDoor" Text="닫힘" FontSize="16" FontWeight="Bold" Foreground="#17314F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F9FB" BorderBrush="#E9EEF4" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="통신 상태" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="valComm" Text="미연결" FontSize="16" FontWeight="Bold" Foreground="#F44336" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#FFF0F0" BorderBrush="#FCD0D0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,10,0,0">
                        <Grid>
                            <TextBlock Text="비상정지" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
                            <TextBlock x:Name="valEmergency" Text="정상" FontSize="16" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="호출 큐" FontSize="18" FontWeight="Bold" Foreground="#17314F" Margin="0,0,0,20"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="2F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="3F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="4F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#888888"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="5F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#888888"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="▲" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2196F3" FontWeight="Bold" FontSize="16"/>
                        <Ellipse x:Name="qUp1" Grid.Row="1" Grid.Column="1" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qUp2" Grid.Row="1" Grid.Column="2" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qUp3" Grid.Row="1" Grid.Column="3" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qUp4" Grid.Row="1" Grid.Column="4" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qUp5" Grid.Row="1" Grid.Column="5" Style="{StaticResource QueueLed}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="▼" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F44336" FontWeight="Bold" FontSize="16"/>
                        <Ellipse x:Name="qDn1" Grid.Row="2" Grid.Column="1" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qDn2" Grid.Row="2" Grid.Column="2" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qDn3" Grid.Row="2" Grid.Column="3" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qDn4" Grid.Row="2" Grid.Column="4" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qDn5" Grid.Row="2" Grid.Column="5" Style="{StaticResource QueueLed}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="IN" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4CAF50" FontWeight="Bold" FontSize="14"/>
                        <Ellipse x:Name="qInt1" Grid.Row="3" Grid.Column="1" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qInt2" Grid.Row="3" Grid.Column="2" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qInt3" Grid.Row="3" Grid.Column="3" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qInt4" Grid.Row="3" Grid.Column="4" Style="{StaticResource QueueLed}"/>
                        <Ellipse x:Name="qInt5" Grid.Row="3" Grid.Column="5" Style="{StaticResource QueueLed}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>